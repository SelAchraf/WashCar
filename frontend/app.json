{
  "expo": {
    "name": "WashCar",
    "slug": "washcar",
    "version": "1.0.0",
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "scheme": "washcar",
    "sdkVersion": "51.0.0",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.washcar.app"
    },

    "android": {
      "package": "com.washcar.app"
    },

    "web": {
      "bundler": "metro"
    },

    "updates": {
      "fallbackToCacheTimeout": 0
    },

    "primaryColor": "#1E40AF"
  }
}
